<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Allow nullable annotations everywhere without enabling flow diagnostics for
      legacy code. Projects and files that have been converted can opt in to enable.
    -->
    <Nullable>annotations</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Enable modern .NET 10 analyzers without turning on the most aggressive style rules -->
    <AnalysisLevel>10-recommended</AnalysisLevel>

    <!-- Enforce zero warnings in CI and Release builds, while keeping local Debug fast -->
    <!-- Opt in per converted project/file; the repository-wide legacy baseline is not strict yet. -->
    <!-- <TreatWarningsAsErrors Condition="'$(Configuration)' != 'Debug'">true</TreatWarningsAsErrors> -->

    <!-- Keep high-severity NuGet package vulnerabilities as build errors even in Debug -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>high</NuGetAuditLevel>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Condition="!Exists('packages.config')">
      <PrivateAssets>all</PrivateAssets>
      <Version>3.10.94</Version>
    </PackageReference>
    <PackageReference Include="nini-core" Version="0.9.2.16" />
    <PackageReference Include="UtopiaSkye.OpenMetaverse" Version="1.2.9" />
    <PackageReference Include="UtopiaSkye.OpenMetaverse.Types" Version="1.2.9" />
    <PackageReference Include="UtopiaSkye.OpenMetaverse.StructuredData" Version="1.2.9" />
    <PackageReference Include="UtopiaSkye.OpenMetaverse.Rendering.Meshmerizer" Version="1.2.9" />
    <PackageReference Include="UtopiaSkye.OpenMetaverse.Rendering.Simple" Version="1.2.9" />
  </ItemGroup>
</Project>
