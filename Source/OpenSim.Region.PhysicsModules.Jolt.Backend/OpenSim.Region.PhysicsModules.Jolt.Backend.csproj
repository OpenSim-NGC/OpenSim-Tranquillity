<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The physics backend: the engine-agnostic IPhysicsBackend and its Jolt implementation,
    JoltPhysicsBackend. It references no OpenSim assembly.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>OpenSim.Region.PhysicsModules.Jolt.Backend</AssemblyName>
    <RootNamespace>OpenSim.Region.PhysicsModules.Jolt.Backend</RootNamespace>
    <AssemblyTitle>OpenSim.Region.PhysicsModules.Jolt.Backend</AssemblyTitle>
    <Company>http://opensimulator.org</Company>
    <Product>OpenSim</Product>
    <Copyright>OpenSimulator developers</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><!-- 2.19.x HeightFieldShapeSettings takes float* -->
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS0168</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The managed Jolt binding. 2.22.0 is the 5.6 generation (13 July 2026) whose native package is
         JoltPhysics.Native 1.1.0, built from joltc on the day of commit 886e0886 (Jolt v5.6.0, e77f1755).
         A later package (2.26.0 / Native 1.3.0) is the 5.7 generation and is not this pin.
         Changing it means checking the native's record again (JoltNativePackageTests). -->
    <PackageReference Include="JoltPhysicsSharp" Version="2.22.0" />
    <!-- The native package JoltPhysicsSharp 2.22.0 depends on, named here so its version is pinned in one place.
         Its files flow to every application that reaches this project, under runtimes/<rid>/native/.
         linux-x64 is then replaced by the deterministic joltc built from those commits (JoltNative.targets).
         JoltNative.Known records the hash of each loaded file; a new version fails JoltNativePackageTests until
         the record is checked again. -->
    <PackageReference Include="JoltPhysics.Native" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenSim.Region.PhysicsModules.Jolt.Backend.Tests" />
  </ItemGroup>

</Project>
