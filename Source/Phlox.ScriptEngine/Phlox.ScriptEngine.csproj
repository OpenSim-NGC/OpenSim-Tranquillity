<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyTitle>Phlox.ScriptEngine</AssemblyTitle>
  </PropertyGroup>

  <!-- NuGet deps Phlox brings in (not used elsewhere in Tranquillity) -->
  <ItemGroup>
    <PackageReference Include="protobuf-net" Version="3.*" />
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <PackageReference Include="log4net" Version="3.3.1" />
  </ItemGroup>

  <!-- C5 via develop's Library/C5.dll (single identity — avoids the dual-C5 TypeLoadException). -->
  <ItemGroup>
    <Reference Include="C5" HintPath="..\..\Library\C5.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InWorldz.Phlox\InWorldz.Phlox.csproj" />
    <ProjectReference Include="..\OpenSim.Framework\OpenSim.Framework.csproj" />
    <ProjectReference Include="..\OpenSim.Region.Framework\OpenSim.Region.Framework.csproj" />
    <ProjectReference Include="..\OpenSim.Region.ScriptEngine.Shared\OpenSim.Region.ScriptEngine.Shared.csproj" />
    <ProjectReference Include="..\OpenSim.Region.OptionalModules\OpenSim.Region.OptionalModules.csproj" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
