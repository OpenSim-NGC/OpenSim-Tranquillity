<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the Jolt module and its backend. Most drive real JoltPhysicsBackend instances and so need
    the native joltc, which the tests run on for win-x64 and linux-x64. Some read the source instead: a broken
    TempAllocator lock discipline ends in std::abort() inside joltc, which kills the test host rather than
    failing an assertion, so those invariants are checked on the code's structure.
  -->
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The sculpt and mesh-fetch tests build SKBitmap maps. SkiaSharp brings its Windows and macOS natives along; the
       Linux one is a separate package, which the region server also references. -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
  </ItemGroup>

  <!-- The joltc arrives from the JoltPhysics.Native package, under runtimes/<rid>/native/, as in the region server. -->
  <Import Project="..\..\Source\OpenSim.Region.PhysicsModules.Jolt.Backend\JoltNative.targets" />

  <ItemGroup>
    <ProjectReference Include="..\..\Source\OpenSim.Region.PhysicsModules.Jolt.Backend\OpenSim.Region.PhysicsModules.Jolt.Backend.csproj" />
    <ProjectReference Include="..\..\Source\OpenSim.Region.PhysicsModules.Jolt\OpenSim.Region.PhysicsModules.Jolt.csproj" />
    <!-- The mesher a region loads with meshing = Meshmerizer, for the tests that cook a mesh asset. -->
    <ProjectReference Include="..\..\Source\OpenSim.Region.PhysicsModules.Meshing\OpenSim.Region.PhysicsModules.Meshing.csproj" />
    <ProjectReference Include="..\OpenSim.Tests.Common\OpenSim.Tests.Common.csproj" />
  </ItemGroup>

  <!-- Helpers shared with the other Jolt test projects, compiled into each project that uses them. -->
  <ItemGroup>
    <Compile Include="..\JoltTestShared\TestNativeOverride.cs" Link="Shared\TestNativeOverride.cs" />
    <Compile Include="..\JoltTestShared\JoltTestBackend.cs" Link="Shared\JoltTestBackend.cs" />
    <Compile Include="..\JoltTestShared\HalcyonMotorModel.cs" Link="Shared\HalcyonMotorModel.cs" />
    <Compile Include="..\JoltTestShared\VehicleBehaviourRig.cs" Link="Shared\VehicleBehaviourRig.cs" />
    <Compile Include="..\JoltTestShared\FloatRounding.cs" Link="Shared\FloatRounding.cs" />
    <Compile Include="..\JoltTestShared\HalcyonAttitudeAndHoverModels.cs" Link="Shared\HalcyonAttitudeAndHoverModels.cs" />
    <Compile Include="..\JoltTestShared\PinnedMaterialsAttribute.cs" Link="Shared\PinnedMaterialsAttribute.cs" />
    <Compile Include="..\JoltTestShared\MaterialPins.cs" Link="Shared\MaterialPins.cs" />
    <Compile Include="..\JoltTestShared\ScratchFolders.cs" Link="Shared\ScratchFolders.cs" />
    <Compile Include="..\JoltTestShared\MeshShapesTodayHelpers.cs" Link="Shared\MeshShapesTodayHelpers.cs" />
    <Compile Include="..\JoltTestShared\HalcyonLinearReference.cs" Link="Shared\HalcyonLinearReference.cs" />
    <Compile Include="..\JoltTestShared\VehicleInWorldzMotorModel.cs" Link="Shared\VehicleInWorldzMotorModel.cs" />
    <Compile Include="..\JoltTestShared\PrimHullProbeShapes.cs" Link="Shared\PrimHullProbeShapes.cs" />
  </ItemGroup>

</Project>
