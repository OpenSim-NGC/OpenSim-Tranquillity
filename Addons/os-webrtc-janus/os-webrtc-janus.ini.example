[WebRtcVoice]
    Enabled=false
    ; Module to use for spatial WebRtcVoice
    ; The following is for a Janus service just for spatial voice for this region. Config in [JanusWebRtcVoice]
    SpatialVoiceService = WebRtcJanusService.dll:WebRtcJanusService
    ; The following is for a grid spatial voice service for this region. Link is WebRtcVoiceServiceURI
    ; SpatialVoiceService=WebRtcVoice.dll:WebRtcVoiceServiceConnector
    ; Module to use for non-spatial WebRtcVoice. Local voice service. Config in [JanusWebRtcVoice]
    NonSpatialVoiceService = WebRtcJanusService.dll:WebRtcJanusService
    ; The following is for a grid non-spatial voice service. For groups and IMs.  Link is WebRtcVoiceServiceURI
    ; NonSpatialVoiceService=WebRtcVoice.dll:WebRtcVoiceServiceConnector
    ; URL for the grid service that is providing the WebRtcVoiceService. Used by WebRtcVoiceServiceConnector.
    ;WebRtcVoiceServerURI = ${Const|PrivURL}:${Const|PrivatePort}
    ; Debugging: output to log file messages sent and received from the viewer. Very verbose.
    MessageDetails = false

    ; Comma-separated STUN server URIs advertised to viewers as the SimulatorFeatures "stun-servers"
    ; entry. Each entry must be a full ICE URI with scheme and no quotes. Stock viewers need at least one
    ; STUN server to connect from outside the grid's network, so set this unless the core server
    ; already advertises one.
    ; Default: empty, and the entry is not advertised. Works with the stock plugin.
    ;StunServers = stun:stun.l.google.com:19302

    ; Avatar-to-avatar calls (the "call" and "start p2p voice" chat session requests). Default: false.
    ; With it off the chat session handler answers as it did before. A call rings only an avatar whose region
    ; runs in the same region-server process as the caller's.
    ;A2AVoiceEnabled = false

    ; Limits on non-spatial sessions. An unanswered invitation expires after 2 minutes and an idle session after
    ; 8 hours (a session with someone still in it is never idle).
    ; Most sessions of all kinds this region server holds at once. A start beyond it is refused. Default: 5000.
    ;MaxNonSpatialSessions = 5000
    ; Most live sessions one agent may have started. A start beyond it is refused. Default: 20.
    ;MaxSessionsPerAgent = 20

    ; Group voice. Default: false. Needs the Groups module.
    ;GroupVoiceEnabled = false
    ; Require the group role power to speak (GP_SESSION_VOICE) as well as to join. Default: true.
    ;GroupVoiceRequireVoicePower = true
    ; Largest number of seats in one group voice session. Default: 50.
    ;GroupVoiceCap = 50

    ; Group, conference and avatar-to-avatar calls ring people who are on another region server (another
    ; process) through grid instant messages, and conference text lines cross the same way. So do the
    ; answers of an avatar-to-avatar call: the callee joining, declining or hanging up. Those messages are
    ; signed with this secret and an unsigned or wrongly signed one is refused. A grid that runs its regions
    ; in more than one process must set the SAME secret, at least 32 characters, on every region server for
    ; these calls to ring across them. Unset (the default), nothing is sent across processes and every such
    ; message that arrives is refused; calls between regions of one process are not affected.
    ; With SessionStoreMode = grid (below), no secret is needed: the receiving region asks the voice session
    ; service whether a ring or an answer is genuine, and conference text lines are signed with a key the
    ; service keeps for each conference and gives only to its members. A region that sets a secret anyway also
    ; signs and requires the signature on rings.
    ; Keep it out of version control.
    ;CarrierSecret =

    ; Where group, conference and avatar-to-avatar call sessions are kept. Default: local, each region
    ; process keeps its own (calls across region processes then depend on CarrierSecret above, the seat
    ; limit is counted per process and each process rings the group itself). Set grid to keep them in
    ; the voice session service that Robust hosts, so every process shares one record of each call: one
    ; seat count, one ring, and seats released when a region restarts. Needs the Robust side configured
    ; ([WebRtcVoiceSessionService] in the grid server settings) and all region processes set the same way.
    ; With grid set, a call that cannot reach the service is refused; it never falls back to a local record.
    ;SessionStoreMode = local

    ; Required when SessionStoreMode is grid: the base address of the Robust server that hosts the service,
    ; for example http://robust.example.org:8003. Use the private port.
    ;SessionStoreServerURI =

    ; Also required for grid: the service accepts only HTTP basic authentication. Set these here, or in
    ; [Network], to the user and password of [WebRtcVoiceSessionService] on the Robust side
    ; (password at least 32 characters). Keep the password out of version control.
    ;AuthType = "BasicHttpAuthentication"
    ;HttpAuthUsername =
    ;HttpAuthPassword =

    ; Grid only: milliseconds to wait for the service before the request is refused. Default 3000.
    ;SessionStoreTimeoutMs = 3000

    ; Grid only: seconds between a region telling the service which seats it still holds (the seats of agents
    ; that are still in the region and in the call). The service releases a seat its region has not renewed for
    ; SeatLeaseSeconds (180 by default) on its side, so keep this at a third of that or less. Default 60.
    ;SessionSeatRenewSeconds = 60

    ; Grid only: when the service cannot be reached, a departure (a viewer leaving a call) is kept and sent
    ; when it answers again. The most departures kept, and the seconds each is kept before it is given up.
    ; A seat given up is returned by the seat lease. Defaults 256 and 60.
    ;SessionStoreOutboxMax = 256
    ;SessionStoreOutboxSeconds = 60

    ; Grid only: after this many calls get no answer within SessionStoreBreakerWindowSeconds, further calls
    ; are refused at once for SessionStoreBreakerOpenSeconds instead of each waiting out
    ; SessionStoreTimeoutMs; then one call is tried to see whether the service is back. Defaults 5, 10 and 5.
    ;SessionStoreBreakerFailures = 5
    ;SessionStoreBreakerWindowSeconds = 10
    ;SessionStoreBreakerOpenSeconds = 5

    ; Ad-hoc voice and conference text ("start conference"). Default: false. Needs the Groups module for
    ; the conference text session.
    ;AdhocVoiceEnabled = false
    ; Per-agent rate limit shared by "start conference" and "invite": the number of requests allowed back to
    ; back, and the seconds for one more to become available once they are used. Default: 5 and 10.
    ;ConferenceRequestBurst = 5
    ;ConferenceRequestRefillSeconds = 10

    ; Call moderation: a member of a group who holds the Moderate Group Chat power can, from the viewer's
    ; participant list, mute one member's voice or text, or mute and unmute everyone's voice, in a group call. The
    ; power is checked on every request; a moderator is never muted. Conferences are not moderated from the
    ; viewer; the region console moderates both (voice call mute, unmute, mute-all, unmute-all, remove, readmit).
    ; Default: false, and then these requests are answered as they were before this key existed.
    ; Needs GroupVoiceEnabled or AdhocVoiceEnabled.
    ; A voice mute needs a voice server that can carry it out: the stock AudioBridge's own participant mute. A
    ; voice mute that cannot be carried out is answered 501 or 503 and is not recorded.
    ; Mute-all and every voice and text mute end with the call: when the last member leaves, the next call of the
    ; group or conference starts unmuted. A removal keeps its own lifetime (CallRemovalMinutes). With
    ; SessionStoreMode = local the record belongs to this region server only.
    ;CallModerationEnabled = false
    ; Seconds between checks that members' moderator flags in the participant list are still right. 0 = never.
    ; Only used when CallModerationEnabled is true. Default: 60.
    ;CallModerationRevalidateSeconds = 60
    ; A member who is removed from a call (from the region console; the stock viewers have no removal in the
    ; participant list) is dropped from the call's voice, told to close the call, and refused every way back
    ; into it: a new call, accepting the invitation, being invited again and a voice provision. A removal from
    ; a group call leaves the group's text alone; a removal from a conference also removes the member from the
    ; conference's text. By default a removal lasts until the call ends, that is until the last seat is
    ; released. CallRemovalMinutes, when above 0, makes a removal last that many minutes instead, and keeps the
    ; call's record for as long. Only used when CallModerationEnabled is true. Default: 0.
    ;CallRemovalMinutes = 0

    ; Per-listener visibility: the region computes who may hear whom (estate and parcel bans, parcel
    ; "see avatars", voice moderation) and sends it to the mixer as peer_ctl batches. Default: false for
    ; both keys. Needs the slvoice mixer and JanusGatewayAdminURI and AdminAPIToken below. With the
    ; feeder on and emission off the feeder runs matrix-only (diagnostics). With the stock AudioBridge a
    ; switch that is on logs one warning at start and stays off.
    ;VisibilityFeederEnabled = false
    ;VisibilityEmitEnabled = false
    ; Milliseconds between visibility recomputations. Default: 250.
    ;VisibilityTickMs = 250
    ; Rooms addressed concurrently within one peer_ctl send. Default: 4.
    ;VisibilityRoomSendConcurrency = 4
    ; Milliseconds between the heartbeats a region sends to the mixer when VisibilityArmingEnabled is on. Default:
    ; 1000. A region server that runs many regions sends one heartbeat per region per interval and can lengthen it.
    ; The mixer treats a region that has been silent for its staleness window (JS_VIS_STALE_MS, 8000 by default) as
    ; gone, so the allowed range is 250 to 4000; a value outside it is refused with a warning and 1000 is used.
    ;VisibilityHeartbeatMs = 1000

    ; Declare the visibility authority when creating a room, with epochs and heartbeats; the mixer
    ; withholds audio from a room whose authority goes silent. Default: false. Needs the slvoice mixer and
    ; both visibility keys above.
    ;VisibilityArmingEnabled = false

    ; The region signs a short-lived join capability for every avatar join and sends it to the mixer, which
    ; can refuse a join that lacks a valid one. Default: false. Needs the slvoice mixer and
    ; [JanusWebRtcVoice] JoinCapabilitySecret. With the stock plugin it logs a warning at start and stays off.
    ;JoinCapabilityEnabled = false

    ; Parcel voice moderation (the SpatialVoiceModerationRequest capability and the voice moderation
    ; console commands). Default: false. With the slvoice mixer it needs VisibilityFeederEnabled. With the stock
    ; AudioBridge a mute is the plugin's own mute of that participant in its room (a mute-all is remembered per
    ; parcel and also applies to whoever joins afterwards), and a request the plugin cannot carry out is
    ; answered 501 rather than 200.
    ;VoiceModerationEnabled = false

    ; Position feed: the region tells the mixer where each voice participant really is (its position, a speed
    ; allowance and a tolerance), so a viewer's own claim of its position can be compared with it. Default:
    ; false, and nothing is computed or sent. Needs VisibilityFeederEnabled and VisibilityEmitEnabled, and a
    ; mixer that advertises vis_protocol 3; an older mixer is sent nothing. The region learns the version itself:
    ; from the replies it already gets, or by asking once. Mixer only: on the stock plugin
    ; it logs one warning and is turned off.
    ;PositionFeedEnabled = false
    ; observe or enforce. Default: observe (the mixer counts what it would change and changes nothing).
    ; enforce is accepted but not active yet; positions are sent in observe mode.
    ;PositionFeedMode = observe
    ; Milliseconds between looks at the participants' positions, 100 or more. Default: 500.
    ;PositionFeedTickMs = 500
    ; A room's full set of positions is sent this often. 1 to 2250; outside that range a warning and the default.
    ; The mixer drops a point 6000 ms after it received it, and the gap between two full sets is this plus up to
    ; 750 ms, so a larger value would let one lost request make a standing participant stale. Default: 2000.
    ;PositionFeedKeepAliveMs = 2000
    ; Between full sets, a participant is sent again once it has moved this many centimetres. Default: 100.
    ;PositionFeedMoveThresholdCm = 100
    ; Centimetres a viewer's claimed position may differ from the region's before the mixer counts it as off.
    ; Default: 500.
    ;PositionFeedMarginCm = 500
    ; The smallest speed allowance sent, and the ceiling used when the physics engine declares no maximum speed,
    ; in centimetres a second. Defaults: 800 and 10000.
    ;PositionFeedSpeedFloorCmS = 800
    ;PositionFeedSpeedMaxCmS = 10000

    ; Voice connectors: NPC presences (a recorder, an injector) that join a parcel's voice room, configured by
    ; the [VoiceConnector.<name>] records below. Needs the NPC module and the slvoice mixer, release 1.2.0 or
    ; later; with the stock AudioBridge this logs one warning at start and stays
    ; off. Default: false. With it off no [VoiceConnector.*] record is read and no NPC is created.
    ;ConnectorsEnabled = false
    ; Let any NPC presence provision voice, not only the registered connector identities. Default: false.
    ;AllowNpcVoice = false
    ; Marker word a connector NPC's first or last name must carry. Default: NPC.
    ;NpcNameToken = NPC
    ; Range in metres used for the connector proximity notice. Default: 20.
    ;VoiceRangeMetres = 20

    ; Seconds a refused voice provision is remembered, so a viewer's immediate retries are answered without
    ; repeating the estate and parcel checks. 0 turns the cache off. Default: 5.
    ;RefusalCacheSeconds = 5

; Voice connector records. One [VoiceConnector.<name>] section per connector, used only with
; ConnectorsEnabled = true; the record is the authorisation, so only an operator can create one. The
; connector NPC's agent id is derived from the grid id, the region name and the record name, so it stays the
; same across restarts; renaming the section or the region gives the connector a new id. Needs the slvoice
; mixer.
;[VoiceConnector.Recorder]
;    Enabled = true
;    NpcFirstName = Recorder
;    NpcLastName = NPC
;    ; Region-local position the connector NPC stands at
;    Position = <128, 128, 25>
;    ; Only "estate" is supported
;    Scope = estate
;    ; false = recording only: the NPC is muted at registration so nothing it sends is heard
;    MayInject = false
;    AuthorisedBy = Operator Name
;    ; Optional: pin the connector to one region of a multi-region instance (scene name).
;    ; Absent = the record starts in every region this instance hosts.
;    ; Region = Example Region
;    ; Optional: secret for the connector's join-capability endpoint, at least 32 characters
;    ; CapabilitySecret =

[JanusWebRtcVoice]
    ; URI to access the Janus Gateway
    JanusGatewayURI = http://janus.example.org:14223/voice
    ; APIKey to access the Janus Gateway. Must be set to the same value as the Janus Gateway.
    ; Use a random secret of at least 32 characters; a shorter one is logged as a warning at startup.
    APIToken = APITokenToNeverCheckIn
    ; URI to access the admin port on Janus Gateway
    JanusGatewayAdminURI = http://janus.example.org/admin
    ; APIKey to access the admin port on the Janus Gateway. Must be set to the same value as the Janus Gateway.
    ; Use a random secret of at least 32 characters; a shorter one is logged as a warning at startup.
    AdminAPIToken = AdminAPITokenToNeverCheckIn
    ; https URLs are validated as before: the certificate must chain to a trusted root and name the host contacted.
    ; This adds a private CA certificate file (PEM or DER), trusted alongside the system roots. No setting turns
    ; validation off. Default: unset.
    ;JanusGatewayCACertificateFile =
    ; Debugging: output to log file messages sent and received from Janus. Very verbose.
    MessageDetails = false

    ; Janus plugin the region attaches voice handles to. Default: janus.plugin.audiobridge (Janus's stock
    ; AudioBridge, flat non-spatial mixing). Set janus.plugin.slvoice to use a spatial mixer that implements
    ; that plugin.
    ;PluginName = janus.plugin.audiobridge
    ; Milliseconds a Janus request that is answered with "ack" waits for its result before it fails.
    ; Default: 5000.
    ;RequestTimeoutMs = 5000
    ; Milliseconds a request to the Janus admin API waits for its answer. Default: 5000.
    ;AdminTimeoutMs = 5000
    ; Secret the join capability is signed with. No default: JoinCapabilityEnabled needs it set, and it must
    ; match the secret configured in the mixer. It must be at least 32 characters; with JoinCapabilityEnabled
    ; on, a shorter one is refused at start with an error and no capability is minted. Never logged.
    ;JoinCapabilitySecret =
    ; Remove a room this service created once nobody has been in it for EmptyRoomGraceSeconds. Janus's stock
    ; AudioBridge never removes an emptied room, so without this every estate, parcel, call and conference room
    ; stays on the gateway until Janus restarts. Rooms the service did not create are never removed. Does nothing
    ; with the slvoice mixer, which removes empty rooms itself. Default: true.
    ;RemoveEmptyRooms = true
    ; Seconds a room stands empty before it is removed. Default: 60.
    ;EmptyRoomGraceSeconds = 60
    

